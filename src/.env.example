# Sao chép thành src/.env rồi điền giá trị thật. KHÔNG commit file .env.

# --- Cơ sở dữ liệu ---
# Dùng cho cách chạy app bằng Python + MySQL của Docker: chạy `docker compose up -d db` (MySQL mở ở cổng 3307).
# Dùng TiDB/MySQL ở xa (vd TiDB Cloud): đổi 4 dòng dưới thành thông tin được cấp (TiDB thường dùng PORT=4000).
# (Chạy TOÀN BỘ bằng Docker thì KHÔNG cần file .env này — xem README mục "chạy toàn bộ bằng Docker".)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=eduflaw
MYSQL_DB=eduflaw_db
# TLS tới CSDL (chống tấn công xen giữa - MITM). Để TRỐNG thì app tự dùng bộ CA công khai của certifi
# (đã có trong requirements) để kết nối vẫn được xác thực chứng chỉ - phù hợp TiDB Cloud, không cần khai báo gì thêm.
# Chỉ cần đặt đường dẫn file CA (PEM) riêng nếu CSDL dùng CA nội bộ không nằm trong bộ CA công khai.
MYSQL_SSL_CA=
# Xác thực cả hostname của chứng chỉ (mặc định true). Chỉ đặt false nếu CA không khớp hostname.
MYSQL_SSL_VERIFY=true
# Chỉ đặt true cho CSDL local không có TLS (vd MySQL trên localhost khi phát triển). KHÔNG dùng khi qua mạng.
MYSQL_SSL_DISABLED=false

# --- Bảo mật ---
# Bắt buộc: chuỗi ngẫu nhiên dài, ví dụ tạo bằng: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Khóa mã hóa CCCD (id_card) ở tầng ứng dụng (AES-256-GCM). Nên đặt riêng, tách khỏi SECRET_KEY;
# để trống sẽ dẫn xuất tạm từ SECRET_KEY. ĐỔI khóa này phải mã hóa lại dữ liệu cũ, nên giữ cố định ở production.
FIELD_ENCRYPTION_KEY=
# Đặt true khi chạy sau HTTPS để cookie session chỉ gửi qua kết nối mã hóa
SESSION_COOKIE_SECURE=false
# Số phút không thao tác trước khi phiên đăng nhập hết hạn (mặc định 30)
SESSION_TIMEOUT_MINUTES=30
# development (bật debug) | production | testing
APP_ENV=development
# Số reverse proxy/PaaS đứng trước app (thường 1). 0 = không tin X-Forwarded-*.
# Bắt buộc đặt đúng khi chạy sau proxy, nếu không khóa đăng nhập theo IP sẽ gom mọi người về IP của proxy.
TRUST_PROXY=0
# Địa chỉ/cổng lắng nghe (serve.py mặc định 0.0.0.0:8000, run.py mặc định 127.0.0.1:5000)
HOST=
PORT=
WAITRESS_THREADS=8

# --- Gửi email OTP (Gmail: dùng App Password 16 ký tự, không phải mật khẩu đăng nhập) ---
# Để trống thì OTP chỉ được in ra console máy chủ khi chạy debug; môi trường khác sẽ báo lỗi gửi OTP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=

# --- Tài khoản Master tạo khi seed dữ liệu mẫu (chỉ dùng nếu DB chưa có Master) ---
MASTER_USERNAME=master@eduflaw.com
# Mật khẩu tài khoản Master khi seed (tối thiểu 12 ký tự). Để trống thì setup.ps1/setup.sh tự sinh ngẫu nhiên.
MASTER_PASSWORD=
# Gmail cá nhân để Master khôi phục mật khẩu bằng OTP (tùy chọn)
MASTER_PERSONAL_EMAIL=
