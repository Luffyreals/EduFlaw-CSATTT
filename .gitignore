# ==============================================================================
# EduFlaw — .gitignore (Bộ lọc bỏ toàn bộ file rác & file tạm không cần thiết)
# ==============================================================================

# --- Môi trường ảo & Dependencies Python ---
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.pdm-python
.pdm-build/
.pixi/
__pypackages__/

# --- Python Cache & Compiled Files ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
MANIFEST

# --- Cache của Pytest, Mypy, Ruff, Coverage ---
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/

# --- File môi trường & Bí mật cục bộ (Local Secrets) ---
.env
.env.local
.env.*.local
*.env
!src/.env.example
*.key
*.pem
*.cert
*.crt
*.pfx

# --- CSDL & Thư mục sinh dữ liệu tạm của Flask ---
instance/
src/instance/
*.sqlite
*.sqlite3
*.sqlite3-journal
*.rdb
*.aof
*.dump
*.sql.bak

# --- File tạm & File khóa của Microsoft Office (Word, PowerPoint, Excel) ---
# Tránh vô tình commit file lock ẩn khi đang mở báo cáo hoặc slide
~$*.docx
~$*.doc
~$*.pptx
~$*.ppt
~$*.xlsx
~$*.xls
*.tmp
*.bak
*.backup
*.old
*.swp
*.swo

# --- File hệ thống Windows / macOS / Linux ---
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
.LSOverride
._*

# --- Cấu hình cá nhân IDE & Editor ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.user
*.userosscache
*.sln.docstates

# --- Log cài đặt & Log tạm (Ngoại trừ log bằng chứng trong pentest/evidence/) ---
*.log
pip-log.txt
pip-delete-this-directory.txt
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ngoại lệ: Giữ lại toàn bộ file log bằng chứng kiểm thử phục vụ báo cáo
!pentest/evidence/*.log
!pentest/evidence/**/*.log
!pentest/evidence/**/*.csv

# --- File tạm của công cụ sinh PDF / Trình duyệt Headless / Scratch ---
chrome_pdf/
headless_browser/
tempCodeRunnerFile.py
test.html
test.pdf
Ban
src/Ban
scratch/
.claude/
.gemini/
